{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
      "buildCommand": "pnpm build",
      "outputDirectory": "dist"
    },
    "server": {
      "root": "apps/server",
      "framework": "hono",
      "entrypoint": "src/index.ts",
      "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
      "buildCommand": "pnpm build",
      "functions": {
        "src/index.ts": {
          "maxDuration": 300
        }
      }
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/index.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:route(config|me|balances|activity|intents|choices|receive|contacts|auth|voice|events|onramp|v1|health|vaults|quotes|chat)/:path*",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/assets/onramp.js",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "web"
      }
    }
  ]
}
