# Circle (developer-controlled wallets + App Kit)
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
# Optional: Circle API key with the "App Kits" permission (swap/earn rate limits)
APPKIT_API_KEY=
# Circle Onramp (sandbox key for development)
ONRAMP_API_KEY=
ONRAMP_ENVIRONMENT=sandbox
ONRAMP_REFERRER_DOMAIN=localhost
# Project admin EOA (testnet only): funds demo wallets, deploys future contracts
ADMIN_PRIVATE_KEY=
# Arc Testnet RPC (falls back to the public RPC)
ARC_RPC_URL=
# OpenAI
OPENAI_API_KEY=
# a fast "mini"-class model for voice latency
OPENAI_MODEL=
# set to "none" for gpt-5.x minis (tool calls need it on chat completions)
OPENAI_REASONING_EFFORT=
# ElevenLabs
ELEVENLABS_API_KEY=
# Server
# Hosted runtime uses the restricted arcie_login.<project-ref> through the transaction pooler (6543).
# Get the exact pooler host from Supabase Connect. Use the rehearsal database for Preview.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/arcie
# Operator only. Inject securely for pnpm db:migrate and pnpm --silent db:import-sqlite.
# Use a separate schema owner with a direct or session-mode connection (5432). Keep this out of Vercel.
DATABASE_MIGRATION_URL=postgres://postgres:postgres@127.0.0.1:5432/arcie
DATABASE_POOL_MAX=3
# Set require when hosted for verified TLS (certificate chain and hostname). Blank auto-detects loopback.
DATABASE_SSL=
# Inject the Supabase dashboard CA as PEM contents when the connection needs its trust root.
DATABASE_SSL_CA=
PORT=8787
DEMO_USER_ID=demo
# Optional server-only secret for hosted sign-in to the existing shared Arc Testnet wallet.
# Available with Privy auth and sandbox onramp. Generate a random secret of at least 32 characters.
DEMO_WALLET_SESSION_SECRET=
# Privy (login: Google / Apple / email; external wallet as a hidden option)
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# optional: copy from Privy dashboard to skip the key fetch
PRIVY_JWT_VERIFICATION_KEY=
# Use privy in Vercel. Dev uses the x-arcie-user header or demo user for local development.
AUTH_MODE=dev
# optional testnet welcome drip from ADMIN_PRIVATE_KEY to each new user's wallet
WELCOME_DRIP_USDC=
# Shared secret ElevenLabs sends to the custom-LLM endpoint (Authorization: Bearer ...)
LLM_SHARED_SECRET=
ELEVENLABS_AGENT_ID=
